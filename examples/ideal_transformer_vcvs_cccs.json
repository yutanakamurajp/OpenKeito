    {"type": "diode", "name": "D1", "nodes": ["s", "pos"]},
    {"type": "diode", "name": "D2", "nodes": ["neg", "s"]},
    {"type": "diode", "name": "D3", "nodes": ["gnd", "pos"]},
    {"type": "diode", "name": "D4", "nodes": ["neg", "gnd"]},
    {"type": "capacitor", "name": "CDC", "nodes": ["pos", "neg"], "capacitance_f": 2e-3},
    {"type": "resistor", "name": "RDC", "nodes": ["pos", "neg"], "resistance_ohm": 4.0},
    {"type": "resistor", "name": "RG", "nodes": ["neg", "gnd"], "resistance_ohm": 100.0}
  ],
  "outputs": [
    {"type": "node_voltage", "node": "p"},
    {"type": "node_voltage", "node": "s"},
