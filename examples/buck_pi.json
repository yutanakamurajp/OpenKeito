{
  "format": "openkeito-model",
  "version": "0.2",
  "name": "buck converter, PI voltage control",
  "description": "The buck converter of buck.json with its output voltage held at 30 V by a PI controller on the duty (limited to 0 .. 0.95). The integral gain puts the crossover of the loop near E*Ki/(2*pi) = 50 Hz, below the LC resonance at 503 Hz. Rows are recorded every 10 steps.",
  "simulation": {
    "time_step_s": 1e-6,
    "end_time_s": 0.1,
    "method": "2s-dirk",
    "output_interval_steps": 10
  },
  "components": [
    {"type": "voltage_source", "name": "E1", "nodes": ["n1", "gnd"], "waveform": {"type": "dc", "value": 100.0}},
    {"type": "controlled_switch", "name": "S1", "nodes": ["n1", "sw"], "gate": "pwm"},
    {"type": "diode", "name": "D1", "nodes": ["gnd", "sw"]},
    {"type": "inductor", "name": "L1", "nodes": ["sw", "out"], "inductance_h": 1e-3},
    {"type": "capacitor", "name": "C1", "nodes": ["out", "gnd"], "capacitance_f": 1e-4},
    {"type": "resistor", "name": "R1", "nodes": ["out", "gnd"], "resistance_ohm": 10.0}
  ],
  "controls": [
    {"type": "constant", "name": "v_ref", "value": 30.0},
    {"type": "measurement", "name": "v_out", "quantity": {"type": "node_voltage", "node": "out"}},
    {"type": "sum", "name": "error", "inputs": ["v_ref", "v_out"], "signs": [1.0, -1.0]},
    {"type": "pi", "name": "duty", "input": "error", "proportional_gain": 0.001, "integral_gain_per_s": 3.0, "output_min": 0.0, "output_max": 0.95},
    {"type": "triangle_wave", "name": "carrier", "frequency_hz": 10000.0},
    {"type": "comparator", "name": "pwm", "inputs": ["duty", "carrier"]}
  ],
  "outputs": [
    {"type": "node_voltage", "node": "out"},
    {"type": "branch_current", "component": "L1"},
    {"type": "signal", "signal": "duty"},
    {"type": "signal", "signal": "error"}
  ]
}
