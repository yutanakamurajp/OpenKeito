{
  "format": "openkeito-model",
  "version": "0.5",
  "name": "averaged grid-following converter: reactive power against a voltage dip",
  "description": "The converter of converter.json with an outer loop written with control blocks: the reactive power reference q_cmd is 4 Mvar (2 per unit) per unit of voltage below the voltage at t = 0, beyond a dead band of 0.1 per unit, limited to 2.2 Mvar. v_set keeps the voltage PV1.v_d of t = 0 (initial_value), so the run starts in the steady state of the power flow with q_cmd = 0. A three-phase fault through 1.2 ohm at the bus from 0.1 to 0.25 s takes the voltage to 0.5 per unit: the converter turns to reactive current, which has priority (the default), and the active current gets what the limit of 1.1 per unit leaves. After the fault it returns to its operating point.",
  "simulation": {
    "time_step_s": 5e-05,
    "end_time_s": 0.5,
    "initialization": "steady_state"
  },
  "components": [
    {"type": "three_phase_source", "name": "G1", "bus": "b0", "line_voltage_rms_v": 6600.0, "frequency_hz": 50.0},
    {"type": "coupled_rl", "name": "Z1", "buses": ["b0", "b1"], "impedance": {"type": "sequence", "r1_ohm": 0.2, "l1_h": 0.006, "r0_ohm": 0.6000000000000001, "l0_h": 0.018000000000000002}},
    {"type": "three_phase_load", "name": "LD1", "bus": "b1", "rated_voltage_kv": 6.6, "rated_frequency_hz": 50.0, "active_power_mw": 1.0, "reactive_power_mvar": 0.3},
    {"type": "grid_following_converter", "name": "PV1", "bus": "b1", "rated_power_mva": 2.0, "rated_voltage_kv": 6.6, "rated_frequency_hz": 50.0, "reference": {"type": "power", "active_power_mw": 1.6, "reactive_power_mvar": "q_cmd"}, "current_limit_pu": 1.1, "priority": "reactive", "operating_point": {"active_power_mw": 1.6, "reactive_power_mvar": 0.0, "voltage_kv": 6.531532, "angle_deg": 1.63323}},
    {"type": "fault", "name": "F1", "bus": "b1", "phases": ["a", "b", "c"], "ground": true, "fault_resistance_ohm": 1.2, "start_time_s": 0.1, "clear_time_s": 0.25}
  ],
  "controls": [
    {"type": "initial_value", "name": "v_set", "input": "PV1.v_d"},
    {"type": "sum", "name": "v_drop", "inputs": ["v_set", "PV1.v_d"], "signs": [1.0, -1.0]},
    {"type": "dead_band", "name": "v_drop_beyond", "input": "v_drop", "lower": -0.1, "upper": 0.1},
    {"type": "gain", "name": "q_support", "input": "v_drop_beyond", "gain": 4.0},
    {"type": "limiter", "name": "q_cmd", "input": "q_support", "minimum": -2.2, "maximum": 2.2}
  ],
  "outputs": [
    {"type": "bus_voltage", "bus": "b1"},
    {"type": "branch_current", "component": "PV1"},
    {"type": "signal", "signal": "q_cmd"},
    {"type": "signal", "signal": "PV1.p"},
    {"type": "signal", "signal": "PV1.q"},
    {"type": "signal", "signal": "PV1.v_d"},
    {"type": "signal", "signal": "PV1.i_d"},
    {"type": "signal", "signal": "PV1.i_q"},
    {"type": "signal", "signal": "PV1.i_ref.d"},
    {"type": "signal", "signal": "PV1.i_ref.q"},
    {"type": "signal", "signal": "PV1.pll.frequency_hz"}
  ]
}
