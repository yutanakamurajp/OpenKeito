{
  "format": "openkeito-model",
  "version": "0.5",
  "name": "Synchronous machine against an infinite bus: fault and swing",
  "description": "A 555 MVA, 24 kV, 60 Hz generator (the machine of Kundur's examples 3.1 to 4.1, unsaturated) feeds an infinite bus through two parallel lines of j0.5 ohm each. The machine delivers 450 MW and 150 Mvar at rated terminal voltage; the angle and voltage of the infinite bus are those of that power flow, so the phasor solution reproduces the operating point and the run starts in a steady state (field voltage and mechanical torque keep their values at t = 0). At 0.1 s a three-phase fault at the machine end of line 2 lasts 70 ms; then the rotor swings against the infinite bus at about 1.3 Hz. The signals of the machine are recorded through measurement blocks.",
  "simulation": {
    "time_step_s": 1e-4,
    "end_time_s": 3.0,
    "initialization": "steady_state",
    "output_interval_steps": 20
  },
  "components": [
    {"type": "synchronous_machine", "name": "G1", "bus": "b1",
     "rated_power_mva": 555.0, "rated_voltage_kv": 24.0, "frequency_hz": 60.0,
     "xd_pu": 1.81, "xq_pu": 1.76, "xd_transient_pu": 0.30, "xq_transient_pu": 0.65,
     "xd_subtransient_pu": 0.23, "xq_subtransient_pu": 0.25, "xl_pu": 0.15, "ra_pu": 0.003,
     "td0_transient_s": 8.0, "td0_subtransient_s": 0.03, "tq0_transient_s": 1.0, "tq0_subtransient_s": 0.07,
     "inertia_h_s": 3.5, "damping_pu": 0.0,
     "operating_point": {"active_power_mw": 450.0, "reactive_power_mvar": 150.0, "voltage_pu": 1.0, "angle_deg": 0.0}},
    {"type": "coupled_rl", "name": "LINE1", "buses": ["b1", "inf"],
     "impedance": {"type": "sequence", "r1_ohm": 0.02, "l1_h": 0.0013263, "r0_ohm": 0.06, "l0_h": 0.0039789}},
    {"type": "coupled_rl", "name": "LINE2", "buses": ["b1", "inf"],
     "impedance": {"type": "sequence", "r1_ohm": 0.02, "l1_h": 0.0013263, "r0_ohm": 0.06, "l0_h": 0.0039789}},
    {"type": "three_phase_source", "name": "INF", "bus": "inf", "line_voltage_rms_v": 22725.6, "frequency_hz": 60.0, "angle_deg": -11.7426},
    {"type": "fault", "name": "F1", "bus": "b1", "phases": ["a", "b", "c"], "ground": true,
     "fault_resistance_ohm": 0.01, "ground_resistance_ohm": 0.01, "start_time_s": 0.1, "clear_time_s": 0.17}
  ],
  "controls": [
    {"type": "measurement", "name": "speed", "quantity": {"type": "component_signal", "component": "G1", "signal": "speed_pu"}},
    {"type": "measurement", "name": "angle", "quantity": {"type": "component_signal", "component": "G1", "signal": "angle_rad"}},
    {"type": "measurement", "name": "torque", "quantity": {"type": "component_signal", "component": "G1", "signal": "electrical_torque_pu"}},
    {"type": "measurement", "name": "p", "quantity": {"type": "component_signal", "component": "G1", "signal": "active_power_pu"}},
    {"type": "measurement", "name": "q", "quantity": {"type": "component_signal", "component": "G1", "signal": "reactive_power_pu"}},
    {"type": "measurement", "name": "vt", "quantity": {"type": "component_signal", "component": "G1", "signal": "terminal_voltage_pu"}},
    {"type": "measurement", "name": "ifd", "quantity": {"type": "component_signal", "component": "G1", "signal": "field_current_pu"}}
  ],
  "outputs": [
    {"type": "bus_voltage", "bus": "b1"},
    {"type": "branch_current", "component": "G1"},
    {"type": "signal", "signal": "speed"},
    {"type": "signal", "signal": "angle"},
    {"type": "signal", "signal": "torque"},
    {"type": "signal", "signal": "p"},
    {"type": "signal", "signal": "q"},
    {"type": "signal", "signal": "vt"},
    {"type": "signal", "signal": "ifd"}
  ]
}
